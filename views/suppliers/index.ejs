<%- include('../partials/header') %>

<div class="page-head">
  <h1>Suppliers</h1>
  <a href="/suppliers/new" class="btn btn-primary">+ New Supplier</a>
</div>

<% if (suppliers.length === 0) { %>
  <p class="muted">No suppliers yet.</p>
<% } else { %>
  <table>
    <thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Actions</th></tr></thead>
    <tbody>
      <% suppliers.forEach(function (s) { %>
        <tr>
          <td><a href="/suppliers/<%= s._id %>"><%= s.name %></a></td>
          <td><%= s.email %></td>
          <td><%= s.phone || '-' %></td>
          <td class="actions">
            <a href="/suppliers/<%= s._id %>" class="btn btn-small">View</a>
            <a href="/suppliers/<%= s._id %>/edit" class="btn btn-small">Edit</a>
            <% if (user.role === 'admin') { %>
              <a href="/suppliers/<%= s._id %>/delete" class="btn btn-small btn-danger">Delete</a>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
