<%- include('../partials/header') %>

<div class="page-head">
  <h1><%= supplier.name %></h1>
  <div class="actions">
    <a href="/suppliers/<%= supplier._id %>/edit" class="btn">Edit</a>
    <% if (user.role === 'admin') { %>
      <a href="/suppliers/<%= supplier._id %>/delete" class="btn btn-danger">Delete</a>
    <% } %>
  </div>
</div>

<div class="card">
  <p><strong>Email:</strong> <%= supplier.email %></p>
  <p><strong>Phone:</strong> <%= supplier.phone || '-' %></p>
  <p><strong>Address:</strong> <%= supplier.address || '-' %></p>
</div>

<!-- Many-to-many: all products this supplier provides -->
<h2>Products supplied (<%= products.length %>)</h2>
<% if (products.length === 0) { %>
  <p class="muted">This supplier is not linked to any products yet.
    Link it from a product's "Manage Suppliers" page.</p>
<% } else { %>
  <table>
    <thead><tr><th>Name</th><th>SKU</th><th>Category</th></tr></thead>
    <tbody>
      <% products.forEach(function (p) { %>
        <tr>
          <td><a href="/products/<%= p._id %>"><%= p.name %></a></td>
          <td><%= p.sku %></td>
          <td><%= p.category ? p.category.name : '-' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<p><a href="/suppliers">&larr; Back to suppliers</a></p>

<%- include('../partials/footer') %>
