<%- include('../partials/header') %>

<div class="card narrow">
  <h1>Delete Supplier</h1>
  <p>Are you sure you want to delete <strong><%= supplier.name %></strong>?
    It will also be unlinked from all its products. This cannot be undone.</p>
  <form action="/suppliers/<%= supplier._id %>?_method=DELETE" method="POST">
    <button type="submit" class="btn btn-danger">Yes, Delete</button>
    <a href="/suppliers/<%= supplier._id %>" class="btn">Cancel</a>
  </form>
</div>

<%- include('../partials/footer') %>
