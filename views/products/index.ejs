<%- include('../partials/header') %>

<div class="page-head">
  <h1>Products</h1>
  <a href="/products/new" class="btn btn-primary">+ New Product</a>
</div>

<% if (products.length === 0) { %>
  <p class="muted">No products yet.</p>
<% } else { %>
  <table>
    <thead><tr><th>Name</th><th>SKU</th><th>Category</th><th>Price</th><th>Qty</th><th>Actions</th></tr></thead>
    <tbody>
      <% products.forEach(function (p) { %>
        <tr>
          <td><a href="/products/<%= p._id %>"><%= p.name %></a></td>
          <td><%= p.sku %></td>
          <td><%= p.category ? p.category.name : '-' %></td>
          <td>$<%= p.price.toFixed(2) %></td>
          <td class="<%= p.quantity < 5 ? 'low' : '' %>"><%= p.quantity %></td>
          <td class="actions">
            <a href="/products/<%= p._id %>" class="btn btn-small">View</a>
            <a href="/products/<%= p._id %>/edit" class="btn btn-small">Edit</a>
            <% if (user.role === 'admin') { %>
              <a href="/products/<%= p._id %>/delete" class="btn btn-small btn-danger">Delete</a>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
