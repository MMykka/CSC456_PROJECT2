<%- include('../partials/header') %>

<!-- Separate view for managing the many-to-many relationship (Product <-> Supplier) -->
<div class="card narrow">
  <h1>Manage Suppliers</h1>
  <p>Select the suppliers for <strong><%= product.name %></strong>:</p>

  <% if (suppliers.length === 0) { %>
    <p class="muted">No suppliers exist yet. <a href="/suppliers/new">Create one first.</a></p>
  <% } else { %>
    <form action="/products/<%= product._id %>/suppliers?_method=PUT" method="POST">
      <div class="checklist">
        <% suppliers.forEach(function (s) { %>
          <label class="check">
            <input type="checkbox" name="suppliers" value="<%= s._id %>"
              <%= linkedIds.includes(s._id.toString()) ? 'checked' : '' %>>
            <%= s.name %> <span class="muted">(<%= s.email %>)</span>
          </label>
        <% }) %>
      </div>
      <button type="submit" class="btn btn-primary">Save Suppliers</button>
      <a href="/products/<%= product._id %>" class="btn">Cancel</a>
    </form>
  <% } %>
</div>

<%- include('../partials/footer') %>
