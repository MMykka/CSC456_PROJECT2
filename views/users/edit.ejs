<%- include('../partials/header') %>

<div class="card narrow">
  <h1>Change Role</h1>
  <p><strong><%= editUser.name %></strong> (<%= editUser.email %>)</p>
  <form action="/users/<%= editUser._id %>?_method=PUT" method="POST">
    <label>Role
      <select name="role">
        <option value="employee" <%= editUser.role === 'employee' ? 'selected' : '' %>>employee</option>
        <option value="admin" <%= editUser.role === 'admin' ? 'selected' : '' %>>admin</option>
      </select>
    </label>
    <button type="submit" class="btn btn-primary">Save</button>
    <a href="/users" class="btn">Cancel</a>
  </form>
</div>

<%- include('../partials/footer') %>
