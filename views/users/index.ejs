<%- include('../partials/header') %>

<h1>Users</h1>
<p class="muted">Only admins can see this page. New users register as <strong>employee</strong>.</p>

<table>
  <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Actions</th></tr></thead>
  <tbody>
    <% users.forEach(function (u) { %>
      <tr>
        <td><%= u.name %></td>
        <td><%= u.email %></td>
        <td><span class="badge badge-<%= u.role %>"><%= u.role %></span></td>
        <td class="actions">
          <% if (u._id.toString() === user._id.toString()) { %>
            <span class="muted">(you)</span>
          <% } else { %>
            <a href="/users/<%= u._id %>/edit" class="btn btn-small">Change Role</a>
            <form action="/users/<%= u._id %>?_method=DELETE" method="POST" class="inline"
                  onsubmit="return confirm('Delete this user?')">
              <button type="submit" class="btn btn-small btn-danger">Delete</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('../partials/footer') %>
