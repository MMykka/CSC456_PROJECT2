<%- include('../partials/header') %>

<div class="page-head">
  <h1>Categories</h1>
  <a href="/categories/new" class="btn btn-primary">+ New Category</a>
</div>

<% if (categories.length === 0) { %>
  <p class="muted">No categories yet.</p>
<% } else { %>
  <table>
    <thead><tr><th>Name</th><th>Description</th><th>Actions</th></tr></thead>
    <tbody>
      <% categories.forEach(function (c) { %>
        <tr>
          <td><a href="/categories/<%= c._id %>"><%= c.name %></a></td>
          <td><%= c.description %></td>
          <td class="actions">
            <a href="/categories/<%= c._id %>" class="btn btn-small">View</a>
            <a href="/categories/<%= c._id %>/edit" class="btn btn-small">Edit</a>
            <% if (user.role === 'admin') { %>
              <a href="/categories/<%= c._id %>/delete" class="btn btn-small btn-danger">Delete</a>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/footer') %>
