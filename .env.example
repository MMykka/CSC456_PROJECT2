# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env file to GitHub (it is listed in .gitignore).

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/inventory?retryWrites=true&w=majority

# Secret key used to sign JWT tokens (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# How long a login lasts
JWT_EXPIRES_IN=1d

# Port for the local server (Render sets this automatically)
PORT=3000

# Admin account created by "npm run seed"
ADMIN_EMAIL=admin@inventory.com
ADMIN_PASSWORD=Admin123!
